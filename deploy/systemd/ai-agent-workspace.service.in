[Unit]
Description=AI Agent Workspace local controller
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@RELEASE@/current
EnvironmentFile=@CONFIG@/service.env
ExecStart=/usr/bin/flock --exclusive --nonblock --no-fork @DATA@/service.guard @NODE@ @RELEASE@/current/scripts/service-start.mjs
Restart=always
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
